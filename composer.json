{
  "name": "vendor/crypto-framework",
  "description": "Framework de criptografia moderno e seguro para PHP",
  "type": "library",
  "license": "MIT",
  "keywords": ["cryptography", "encryption", "security", "aes", "chacha20", "rsa", "ecc", "argon2", "hashing"],
  "authors": [
    {
      "name": "Seu Nome",
      "email": "seu.email@exemplo.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "psr/log": "^3.0",
    "paragonie/constant_time_encoding": "^2.6",
    "paragonie/random_compat": "^9.99"
  },
  "suggest": {
    "illuminate/encryption": "Para integração com Laravel",
    "illuminate/hashing": "Para integração com Laravel",
    "laminas/laminas-crypt": "Para funcionalidades adicionais de criptografia",
    "phpseclib/phpseclib": "Para algoritmos criptográficos adicionais"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "vimeo/psalm": "^5.0",
    "friendsofphp/php-cs-fixer": "^3.16",
    "roave/security-advisories": "dev-latest",
    "illuminate/encryption": "^10.0",
    "illuminate/hashing": "^10.0",
    "laminas/laminas-crypt": "^3.8",
    "phpseclib/phpseclib": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "CryptoFramework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CryptoFramework\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan analyze src --level=max",
    "psalm": "psalm",
    "cs-fix": "php-cs-fixer fix src",
    "security-check": "composer audit",
    "benchmark": "php tests/benchmark/run.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
